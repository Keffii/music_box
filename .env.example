# Optional overrides for docker compose. Copy to .env and edit; every value has a default.

# Port for the web player and the ESP32 API on this computer
WEB_PORT=8080

# Shared key for the ESP32 remote. It must match CONFIG_MUSICBOX_DEVICE_KEY in the firmware.
DEVICE_KEY=musicbox-demo-key

# Signing key for login tokens (at least 32 characters). Leave empty to use a random key per restart.
JWT_SECRET=

MYSQL_USER=musicbox
MYSQL_PASSWORD=musicbox
MYSQL_ROOT_PASSWORD=musicbox-root
