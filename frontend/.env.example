# Copy to .env for local development (`npm start`). On AWS these are set as
# Amplify environment variables instead (see docs/DEPLOY_AWS.md).
PORT=8001

# Backend URL: http://localhost:8080 locally, the CloudFront https URL on AWS
REACT_APP_API_BASE=http://localhost:8080

# Cognito user pool (from the Cognito console)
REACT_APP_COGNITO_USER_POOL_ID=eu-north-1_XXXXXXXXX
REACT_APP_COGNITO_APP_CLIENT_ID=your-app-client-id

# Optional: Grafana dashboard link shown in the player. Leave empty to hide it.
REACT_APP_GRAFANA_URL=
