{
  "CallerReference": "music-box-backend-1",
  "Comment": "HTTPS in front of the Music Box backend (Elastic Beanstalk)",
  "Enabled": true,
  "PriceClass": "PriceClass_100",
  "HttpVersion": "http2",
  "Origins": {
    "Quantity": 1,
    "Items": [
      {
        "Id": "eb-backend",
        "DomainName": "EB_CNAME",
        "CustomOriginConfig": {
          "HTTPPort": 80,
          "HTTPSPort": 443,
