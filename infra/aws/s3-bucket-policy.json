{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadMusicAndCovers",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/music/*",
        "arn:aws:s3:::BUCKET_NAME/cover/*"
      ]
    }
  ]
}
